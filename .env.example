GEMINI_API_KEY=
# APP_PASSWORD: only needed on a public deployment (see README > Deployment).
# Leave unset for local dev -- the app runs gate-free without it.
APP_PASSWORD=
# YOUTUBE_API_KEY: free, from Google Cloud Console (enable "YouTube Data
# API v3", create an API key -- no billing required). Needed by
# youtube_source.py to check configured channels for new uploads.
YOUTUBE_API_KEY=
